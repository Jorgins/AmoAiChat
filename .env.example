# Скопируйте этот файл в .env и заполните своими значениями.
#
# По умолчанию сервис настроен на Z.ai (GLM) через их Anthropic-совместимый
# эндпоинт — используется тот же SDK `anthropic`, просто другой base_url.
ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
ANTHROPIC_AUTH_TOKEN=your_zai_api_key

# Модель на стороне Z.ai (пример: glm-4.6 или glm-4.7 — уточните актуальное
# название модели в личном кабинете/документации Z.ai)
CLAUDE_MODEL=glm-4.6

# --- Если вместо Z.ai хотите использовать настоящий Claude API ---
# Удалите/закомментируйте ANTHROPIC_BASE_URL и ANTHROPIC_AUTH_TOKEN выше и
# используйте вместо них:
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5
